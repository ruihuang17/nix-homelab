" --- General Settings ---
set nocompatible            " Disable old vi-compatibility
filetype plugin indent on   " Enable filetype detection and indentation
syntax on                   " Enable syntax highlighting
set number                  " Show line numbers
set relativenumber          " Show relative line numbers (great for jumping)
set mouse=a                 " Enable mouse support (scrolling, clicking)
set clipboard=unnamedplus   " Use system clipboard (requires +clipboard support)
set cursorline              " Highlight the current line

" --- Indentation ---
set tabstop=2               " Number of spaces a <Tab> counts for
set shiftwidth=2            " Number of spaces for auto-indent
set expandtab               " Turn tabs into spaces
set smartindent             " Insert indents automatically

" --- Search ---
set hlsearch                " Highlight all search results
set incsearch               " Show matches as you type
set ignorecase              " Case-insensitive searching...
set smartcase               " ...unless you use a capital letter

" --- Performance & UI ---
set scrolloff=8             " Keep 8 lines above/below cursor when scrolling
set noswapfile              " Skip creating .swp files (prevents annoying prompts)
set hidden                  " Allow switching buffers without saving first
set wildmenu                " Visual autocomplete for command menu

" --- Basic Keybinds ---
" Press Escape to clear search highlights
nnoremap <ESC> :noh<CR>
